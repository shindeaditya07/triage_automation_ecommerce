# Copy to .env and fill in. Never commit .env.
# Every variable the project will ever read is listed here; most are unused until later branches.

# --- Runtime ---------------------------------------------------------------
# local | ci | staging | nonprod | production
ENVIRONMENT=local
# Port the API/mock store listen on. Render needs this to match the Start Command.
PORT=8000

# --- Database --------------------------------------------------------------
# Compose overrides this to point at the "db" container. Use the asyncpg driver form.
DATABASE_URL=postgresql+asyncpg://replydesk:replydesk@localhost:5432/replydesk

# --- API -------------------------------------------------------------------
# Random string, 32+ chars, different in every environment (JWT signing).
SECRET_KEY=dev-secret-key-change-in-prod
BASE_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- LLM -------------------------------------------------------------------
# fake = recorded outputs, no network (used by CI and as the safe default).
# Otherwise anthropic, openai or gemini. The judge must come from a DIFFERENT provider than the drafter so
# a model never grades its own output (docs/adr/0003-llm-provider.md), unless JUDGE_SAME_FAMILY_OK=true.
LLM_PROVIDER=fake
LLM_API_KEY=
# Model IDs: pick current ones from your provider's model page.
LLM_MODEL=
# Sampling temperature for classify and draft. 0 = repeatable. Empty = do not send the parameter
# (for a model that rejects it).
LLM_TEMPERATURE=0
JUDGE_PROVIDER=
JUDGE_API_KEY=
JUDGE_MODEL=
JUDGE_TEMPERATURE=0
# Accept a judge from the same provider as the drafter. Weakens the grounding checks; leave false.
JUDGE_SAME_FAMILY_OK=false
# Embeddings: openai or gemini. EMBED_API_KEY is needed unless LLM_API_KEY or JUDGE_API_KEY is from the
# same provider.
EMBED_PROVIDER=openai
EMBED_API_KEY=
# Blank: text-embedding-3-small for openai, gemini-embedding-001 for gemini.
EMBED_MODEL=
EMBED_DIMENSIONS=1536
LLM_TIMEOUT_SECONDS=30
# Tries per call (first try included) on rate limits, 5xx and timeouts. 4xx other than 429: no retry.
LLM_MAX_ATTEMPTS=3
# After this many failed calls in a row the circuit opens and calls fail fast (the ticket is
# escalated to the owner) for the cooldown, then one probe call is let through.
LLM_BREAKER_FAILURES=5
LLM_BREAKER_COOLDOWN_SECONDS=30
# Prices in INR per 1M tokens, used for cost tracking (FR-14). Update from the providers' price pages.
LLM_INPUT_PRICE_INR_PER_1M=0
LLM_OUTPUT_PRICE_INR_PER_1M=0
JUDGE_INPUT_PRICE_INR_PER_1M=0
JUDGE_OUTPUT_PRICE_INR_PER_1M=0
EMBED_PRICE_INR_PER_1M=0

# --- Auth ------------------------------------------------------------------
OWNER_EMAIL=owner@example.com
# argon2 hash of the owner password: make owner-hash
# Keep the single quotes: Docker Compose would otherwise read the $ signs as variables.
OWNER_PASSWORD_HASH=''
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
# Consecutive failed logins before the account locks (each further failure doubles the lock).
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_BASE_SECONDS=60
LOGIN_LOCKOUT_MAX_SECONDS=3600
LOGIN_IP_MAX_ATTEMPTS=10
LOGIN_IP_WINDOW_SECONDS=300
# Proxies in front of the API whose X-Forwarded-For entry is trusted. Render: 1. Direct: 0.
TRUSTED_PROXY_HOPS=0
# Shared secret for the HMAC-authenticated email-ingestion endpoint.
HMAC_SECRET=dev-hmac-secret

# --- Ticket intake ---------------------------------------------------------
# Public contact form limits. The email endpoint has its own, larger body limit.
FORM_MAX_BODY_BYTES=20000
FORM_MESSAGE_MAX_CHARS=5000
FORM_IP_MAX_PER_MINUTE=3
FORM_IP_MAX_PER_HOUR=10
EMAIL_MAX_BODY_BYTES=262144
EMAIL_BODY_MAX_CHARS=20000
ATTACHMENT_MAX_COUNT=5
ATTACHMENT_MAX_BYTES=10485760

# --- Store profile ---------------------------------------------------------
STORE_NAME=Kaveri Home Goods
STORE_SIGN_OFF=Kaveri Home Goods Support
STORE_TIMEZONE=Asia/Kolkata

# --- Mock store ------------------------------------------------------------
MOCK_STORE_URL=http://localhost:8001
# Seconds to wait for the store before the job is retried later.
MOCK_STORE_TIMEOUT_SECONDS=5
# Freezes "now" for seed dates and tests. Leave EMPTY in staging and production.
FROZEN_NOW=2026-10-15T12:00:00Z

# --- Jobs ------------------------------------------------------------------
LOCK_TIMEOUT_SECONDS=60
SWEEP_INTERVAL_SECONDS=30
JOB_POLL_INTERVAL_SECONDS=2
# false = run the API without the background worker in the same process.
JOB_WORKER_ENABLED=true

# --- Retention -------------------------------------------------------------
RETENTION_DAYS=90

# --- Policy ----------------------------------------------------------------
POLICY_FILE_PATH=docs/policies.md
POLICY_VERSION=1.1
