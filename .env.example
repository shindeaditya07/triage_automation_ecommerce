# Copy to .env and fill in. Never commit .env.
# Every variable the project will ever read is listed here; most are unused until later branches.

# --- Runtime ---------------------------------------------------------------
# local | ci | staging | nonprod | production
ENVIRONMENT=local
# Port the API/mock store listen on. Render needs this to match the Start Command.
PORT=8000

# --- Database --------------------------------------------------------------
# Compose overrides this to point at the "db" container. Use the asyncpg driver form.
DATABASE_URL=postgresql+asyncpg://replydesk:replydesk@localhost:5432/replydesk

# --- API -------------------------------------------------------------------
# Random string, 32+ chars, different in every environment (JWT signing).
SECRET_KEY=dev-secret-key-change-in-prod
BASE_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- LLM -------------------------------------------------------------------
# fake = recorded outputs, no network (used by CI and as the safe default).
LLM_PROVIDER=fake
LLM_API_KEY=
# Model IDs: pick current ones from your provider's model page; the judge must be a
# different model family from the drafter (see docs/AGENTS.md section 5).
LLM_MODEL=
JUDGE_API_KEY=
JUDGE_MODEL=
EMBED_MODEL=text-embedding-3-small
EMBED_DIMENSIONS=1536
LLM_TIMEOUT_SECONDS=30
# Prices in INR per 1M tokens, used for cost tracking (FR-14). Update from the providers' price pages.
LLM_INPUT_PRICE_INR_PER_1M=0
LLM_OUTPUT_PRICE_INR_PER_1M=0
JUDGE_INPUT_PRICE_INR_PER_1M=0
JUDGE_OUTPUT_PRICE_INR_PER_1M=0
EMBED_PRICE_INR_PER_1M=0

# --- Auth ------------------------------------------------------------------
OWNER_EMAIL=owner@example.com
# argon2 hash: uv run python -c "from argon2 import PasswordHasher; print(PasswordHasher().hash('YOUR-PASSWORD'))"
OWNER_PASSWORD_HASH=
# Shared secret for the HMAC-authenticated email-ingestion endpoint.
HMAC_SECRET=dev-hmac-secret

# --- Store profile ---------------------------------------------------------
STORE_NAME=Kaveri Home Goods
STORE_SIGN_OFF=Kaveri Home Goods Support
STORE_TIMEZONE=Asia/Kolkata

# --- Mock store ------------------------------------------------------------
MOCK_STORE_URL=http://localhost:8001
# Freezes "now" for seed dates and tests. Leave EMPTY in staging and production.
FROZEN_NOW=2026-10-15T12:00:00Z

# --- Jobs ------------------------------------------------------------------
LOCK_TIMEOUT_SECONDS=60
SWEEP_INTERVAL_SECONDS=30

# --- Retention -------------------------------------------------------------
RETENTION_DAYS=90

# --- Policy ----------------------------------------------------------------
POLICY_FILE_PATH=docs/policies.md
POLICY_VERSION=1.1
